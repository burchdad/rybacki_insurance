NEXT_PUBLIC_SITE_URL=https://www.rybackiinsuranceagency.com
# Optional local workaround for a locked OneDrive build folder; omit on Vercel.
# NEXT_DIST_DIR=.next-local-build
# Empty adapter fails safely; it never pretends a lead was delivered.
# Use webhook in production. Use development only with fictional test data.
LEAD_ADAPTER=
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Durable Redis REST service required for production rate limiting and idempotency.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SECRET=
# Enable only after reviewing consent/disclosure requirements.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Configure retention with the receiving CRM; this website does not persist leads.
LEAD_RETENTION_DAYS=30
